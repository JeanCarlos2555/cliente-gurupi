# URL base da API backend (subdominio de API). Deve incluir o /api final,
# pois o cliente HTTP usa este valor como baseURL.
# Ex.: https://api-portal.gurupitelecom.com.br/api
VITE_API_URL=https://api-portal.gurupitelecom.com.br/api

# Porta onde vai rodar o container (unica por instancia)
VITE_PORT=4180

# Nome do container Docker (unico por instancia)
VITE_NAME=gurupi_portal_frontend

# Timezone
TZ=America/Fortaleza
