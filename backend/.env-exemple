# ===== Servidor =====
PORT=3030
NODE_ENV=development
# Origem do frontend (CORS). Em dev: http://localhost:5173.
# Em produção: a URL do portal (ex.: https://portal.gurupitelecom.com.br)
FRONTEND_ORIGIN=http://localhost:5173

# ===== Docker / deploy =====
# Nome do container e porta publicada no host (usados pelo docker-compose.yml)
APP_NAME=gurupi_portal_backend
APP_PORT=3030
# Timezone do container
TZ=America/Fortaleza

# ===== JWT do cliente (nosso) =====
CUSTOMER_JWT_SECRET=troque-por-uma-chave-aleatoria-longa
CUSTOMER_JWT_EXPIRESIN=1d
# Nome do cookie httpOnly que carrega a sessão
SESSION_COOKIE_NAME=gt_session
# true em produção (HTTPS). Em dev local deixe false.
COOKIE_SECURE=false
# Política SameSite do cookie de sessão.
# Portal e API em subdomínios diferentes (cross-site) => use "none" em produção (exige HTTPS).
# Em dev local (mesma origem) "lax" basta. (none força secure automaticamente)
COOKIE_SAMESITE=lax

# ===== Criptografia do api_token do provedor (dentro do JWT) =====
# 32 bytes em hex (64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# ===== Documentação Swagger (Basic Auth em /api-docs) =====
SWAGGER_USER=gurupi
SWAGGER_PASSWORD=troque-isto
# Host/esquema que o Swagger usa nas chamadas "Try it out".
# Dev: deixe SWAGGER_HOST vazio (usa localhost:PORT). Produção: o subdomínio de API + https
#   ex.: SWAGGER_HOST=api-portal.gurupitelecom.com.br  /  SWAGGER_SCHEME=https
SWAGGER_HOST=
SWAGGER_SCHEME=http

# ===== Integração provedor beesweb =====
BEESWEB_BASE_URL=https://api.beesweb.com.br
BEESWEB_SUBDOMAIN=gurupitelecom
BEESWEB_AUTH_MODE=cpf_cnpj

# ===== OTP por e-mail =====
# Liga/desliga a verificação OTP. Se false, o login emite o JWT direto após validar o CPF na beesweb.
OTP_ENABLED=true
# Tamanho do código
OTP_LENGTH=6
# Tipo do código: numeric (só dígitos) ou alphanumeric
OTP_TYPE=numeric
# Validade do código em minutos
OTP_EXP_MINUTES=10
# Máximo de tentativas antes de invalidar o desafio
OTP_MAX_ATTEMPTS=5

# ===== SMTP (envio do e-mail do OTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=naoresponda@gurupitelecom.com.br
SMTP_FROM_NAME=Gurupi Telecom
